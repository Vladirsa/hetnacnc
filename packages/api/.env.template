# PLANTILLA DE EJEMPLO. No pongas aquí valores reales: este archivo se sube a GitHub
# y NO configura el servidor. Las claves reales van solo en packages/api/.env.production
# dentro del servidor (git lo ignora). Edítalo con: nano packages/api/.env.production
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:7000,http://localhost:9000
VENDOR_CORS=http://localhost:7001
AUTH_CORS=http://localhost:7000,http://localhost:7001,http://localhost:9000
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
MERCUR_VENDOR_URL=http://localhost:7001
STOREFRONT_REVALIDATE_URL=http://localhost:3000
STOREFRONT_REVALIDATE_SECRET=supersecret
HETNA_FORO_DB=postgresql://postgres:TU_CONTRASENA@db.TU_PROYECTO.supabase.co:5432/postgres

# --- Pagos: Mercado Pago (Checkout Pro) ---
# Sin MERCADOPAGO_ACCESS_TOKEN el módulo no se carga. Usa primero el token de prueba (TEST-...).
MERCADOPAGO_ACCESS_TOKEN=TEST-TU_TOKEN_DE_PRUEBA
# URL pública de la tienda: regreso desde Mercado Pago y link del correo de carrito abandonado.
STOREFRONT_URL=https://hetnacnc.com

# --- Marketing automatizado (opcional) ---
# Sin RESEND_API_KEY, el email de bienvenida y el recordatorio de carrito
# abandonado simplemente no envían nada (no rompen el registro ni el checkout).
# Cuenta en https://resend.com -> API Keys. El FROM debe ser un dominio
# verificado en Resend (o onboarding@resend.dev para pruebas).
RESEND_API_KEY=re_TU_CLAVE_DE_RESEND
RESEND_FROM_EMAIL=HETNA CNC <hola@hetnacnc.com>
# Ventana para considerar un carrito "abandonado" (horas).
ABANDONED_CART_MIN_HOURS=3
ABANDONED_CART_MAX_HOURS=72

# Ventana del correo "califica lo que compraste" (días desde que se hizo la
# orden). El mínimo espera a que la pieza llegue antes de pedir la reseña; el
# máximo deja de insistir cuando el cliente ya ni se acuerda.
RESENA_EMAIL_MIN_DIAS=10
RESENA_EMAIL_MAX_DIAS=60

# URL del webhook de n8n que publica en redes sociales cuando subes un
# producto nuevo al catálogo. Sin esta variable, no se avisa a nadie (no
# rompe la creación del producto). Es la URL del nodo Webhook del workflow
# "Redes sociales - Producto nuevo" en https://n8n.hetnacnc.com.
N8N_PRODUCT_CREATED_WEBHOOK_URL=

# URL del webhook de n8n que avisa (WhatsApp) cuando alguien pide un
# estimado en /cotizar/corte-laser o /cotizar/router-cnc. Sin esta variable,
# el estimado y el correo de confirmación igual se mandan, solo no hay
# aviso instantáneo. Es la URL del nodo Webhook del workflow
# "Leads - Cotizacion rapida" en https://n8n.hetnacnc.com.
N8N_QUOTE_LEAD_WEBHOOK_URL=

# --- Entrega de productos digitales (opcional) ---
# Sin estas variables, el correo de descarga de producto digital no se puede
# generar (no rompe el checkout ni el pago, solo queda sin enviar y se
# registra en el log). Mismo Key ID / Application Key que ya usas en el
# bucket privado de Backblaze B2 (dashboard -> App Keys). El bucket debe ser
# el privado donde HETNA Digital Factory respalda los archivos originales,
# no el bucket público de imágenes de mockup.
B2_KEY_ID=TU_KEY_ID_DE_B2
B2_APPLICATION_KEY=TU_APPLICATION_KEY_DE_B2
B2_PRIVATE_BUCKET_NAME=hetnacnc-archivos-privados

# --- Escaneo 3D (opcional) ---
# Sin RUNPOD_API_KEY o RUNPOD_SCAN3D_ENDPOINT_ID el job `despachar-escaneos`
# no hace nada y no avisa, para no llenar el log cada minuto: los escaneos se
# quedan en cola. La llave se genera en RunPod -> Settings -> API Keys (se
# muestra UNA sola vez); el id del endpoint sale en su página, bajo el nombre.
RUNPOD_API_KEY=
RUNPOD_SCAN3D_ENDPOINT_ID=
# Cuántos créditos cuesta un escaneo profesional. El preview es gratis.
ESCANEO_CREDITOS_POR_TRABAJO=5
# Sólo si algún día n8n reporta el resultado por /escaneos/callback en vez del
# job. Sin esto el callback responde 503 y queda cerrado.
ESCANEO_CALLBACK_SECRET=

# --- Traducción automática del catálogo al inglés (opcional) ---
# Sin LIBRE_TRANSLATE_URL el subscriber `product-auto-translate-libre` no hace
# nada: no llama a nadie y no escribe en el producto. Apunta a un LibreTranslate
# propio (https://github.com/LibreTranslate/LibreTranslate, se levanta con
# Docker). NO sirve https://libretranslate.de: dejó de ser abierta y responde
# con error, y una traducción fallida dejaría el español guardado como si fuera
# inglés. La llave sólo hace falta si la instancia la pide.
LIBRE_TRANSLATE_URL=
LIBRE_TRANSLATE_API_KEY=
