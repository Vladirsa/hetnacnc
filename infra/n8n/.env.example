# Copia este archivo a ".env" (mismo folder) y completa los valores.

# Subdominio donde vivirá n8n. Debe tener un registro DNS tipo A apuntando
# a la IP de este VPS (la misma que usa hetnacnc.com). nginx + certbot en el
# propio VPS son los que emiten el certificado, igual que para hetnacnc.com.
N8N_HOST=n8n.hetnacnc.com

# Subdominio para el panel de Evolution API (WhatsApp). Mismo requisito de DNS.
EVOLUTION_HOST=whatsapp.hetnacnc.com

# Contraseña para la base de datos interna de n8n. Genera una aleatoria, por
# ejemplo con: openssl rand -hex 16
N8N_DB_PASSWORD=

# Clave de cifrado de n8n (protege las credenciales guardadas dentro de n8n).
# Generarla una sola vez y nunca cambiarla después de crear credenciales:
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Clave que protege la API de Evolution (WhatsApp). Genera una aleatoria:
# openssl rand -hex 24
EVOLUTION_API_KEY=

# Contraseña para la base de datos propia de Evolution API (Postgres aparte,
# requerida desde la v2.3+). Genera una aleatoria: openssl rand -hex 16
EVOLUTION_DB_PASSWORD=

# Nombre de la instancia de WhatsApp que crees en el panel de Evolution API
# (https://whatsapp.hetnacnc.com). Tú eliges el nombre al crearla, p. ej. "hetnacnc".
EVOLUTION_INSTANCE=hetnacnc

# --- Conexión con el backend de Mercur/Medusa ---
# Como n8n corre Docker en el MISMO VPS que el backend (PM2, puerto 9000),
# le habla directo por red interna en vez de salir a internet. No cambiar a
# menos que el backend se mueva a otro servidor.
MEDUSA_BACKEND_URL=http://host.docker.internal:9000

# Publishable key del storefront: está en apps/storefront/.env como
# NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY. Se usa para las búsquedas de catálogo.
MEDUSA_PUBLISHABLE_KEY=

# ID de la región (México) que usa el storefront. Se obtiene con (desde el VPS):
# curl -s http://127.0.0.1:9000/store/regions -H "x-publishable-api-key: <la de arriba>"
MEDUSA_REGION_ID=

# Secret API key creada en el Admin de Mercur: https://hetnacnc.com/dashboard
# (Configuración/Settings > Desarrollador > Gestión de claves API > Claves
# secretas > Crear clave secreta). Permite leer/actualizar carritos para el
# recordatorio de carrito abandonado.
MEDUSA_ADMIN_SECRET_KEY=

# URL pública de la tienda (para armar links en los mensajes de WhatsApp).
STOREFRONT_URL=https://hetnacnc.com

# Misma ventana de horas que usa el job de email de carrito abandonado
# (packages/api/.env: ABANDONED_CART_MIN_HOURS / ABANDONED_CART_MAX_HOURS).
ABANDONED_CART_MIN_HOURS=3
ABANDONED_CART_MAX_HOURS=72

# --- Redes sociales (Facebook/Instagram) ---
# ID de tu Página de Facebook. En la Página: Configuración > Acerca de >
# ID de la página (o en Meta Business Suite).
FACEBOOK_PAGE_ID=

# ID de la cuenta de Instagram Business vinculada a esa Página. Se obtiene
# con el Graph API Explorer (ver README) consultando
# /{FACEBOOK_PAGE_ID}?fields=instagram_business_account
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Post-venta y consumibles (seguimiento post-instalación) ---
# ID de la categoría "Materiales y consumibles" en Medusa. Se usa para que el
# descuento de consumibles a los 90 días solo aplique a esa categoría. Ya
# viene resuelto para este catálogo (no hace falta volver a buscarlo):
CONSUMIBLES_CATEGORY_ID=pcat_01M46SEX6076BBYBPSDXMB015D

TIMEZONE=America/Mexico_City
