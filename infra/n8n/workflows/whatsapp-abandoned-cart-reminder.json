{
  "name": "WhatsApp - Recordatorio de carrito abandonado",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 1 }]
        }
      },
      "id": "schedule",
      "name": "Cada hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MEDUSA_BACKEND_URL }}/admin/carts",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "limit", "value": "100" },
            {
              "name": "fields",
              "value": "id,email,currency_code,total,metadata,updated_at,completed_at,items.title,items.quantity,shipping_address.phone"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.MEDUSA_ADMIN_SECRET_KEY }}" }
          ]
        },
        "options": {}
      },
      "id": "fetch-carts",
      "name": "Traer carritos (Admin API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-180, 0]
    },
    {
      "parameters": {
        "jsCode": "// Misma ventana que el job de email en packages/api/src/jobs/abandoned-cart-reminder.ts,\n// pero con su propia marca (abandoned_whatsapp_sent_at) para no pisar el email.\nconst MIN_HOURS = Number($env.ABANDONED_CART_MIN_HOURS || 3);\nconst MAX_HOURS = Number($env.ABANDONED_CART_MAX_HOURS || 72);\n\nconst now = Date.now();\nconst upperBound = now - MIN_HOURS * 60 * 60 * 1000;\nconst lowerBound = now - MAX_HOURS * 60 * 60 * 1000;\n\nconst carts = $input.first().json.carts || [];\n\nconst eligible = carts.filter((cart) => {\n  if (cart.completed_at) return false;\n  if (!cart.items?.length) return false;\n  const phone = cart.shipping_address?.phone;\n  if (!phone) return false;\n  if (cart.metadata?.abandoned_whatsapp_sent_at) return false;\n\n  const updatedAt = new Date(cart.updated_at).getTime();\n  return updatedAt <= upperBound && updatedAt >= lowerBound;\n});\n\nreturn eligible.slice(0, 50).map((cart) => ({\n  json: {\n    id: cart.id,\n    phone: cart.shipping_address.phone,\n    items: cart.items,\n    total: cart.total,\n    currency_code: cart.currency_code,\n  },\n}));"
      },
      "id": "filter-eligible",
      "name": "Filtrar carritos elegibles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [40, 0]
    },
    {
      "parameters": {
        "jsCode": "const cart = $input.first().json;\nconst storefrontUrl = $env.STOREFRONT_URL || 'https://hetnacnc.com';\nconst firstItem = cart.items[0]?.title || 'tu producto';\nconst extra = cart.items.length > 1 ? ` y ${cart.items.length - 1} producto(s) más` : '';\n\nconst message = `¡Hola! Vimos que dejaste en tu carrito: ${firstItem}${extra}. ¿Te ayudamos a completar tu compra? ${storefrontUrl}/mx/cart`;\n\nreturn [{ json: { ...cart, message } }];"
      },
      "id": "build-message",
      "name": "Armar mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"number\": $json.phone, \"text\": $json.message } }}",
        "options": {}
      },
      "id": "send-whatsapp",
      "name": "Enviar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MEDUSA_BACKEND_URL }}/admin/carts/{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.MEDUSA_ADMIN_SECRET_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"metadata\": { \"abandoned_whatsapp_sent_at\": new Date().toISOString() } } }}",
        "options": {}
      },
      "id": "mark-sent",
      "name": "Marcar carrito como notificado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 0]
    }
  ],
  "connections": {
    "Cada hora": {
      "main": [[{ "node": "Traer carritos (Admin API)", "type": "main", "index": 0 }]]
    },
    "Traer carritos (Admin API)": {
      "main": [[{ "node": "Filtrar carritos elegibles", "type": "main", "index": 0 }]]
    },
    "Filtrar carritos elegibles": {
      "main": [[{ "node": "Armar mensaje", "type": "main", "index": 0 }]]
    },
    "Armar mensaje": {
      "main": [[{ "node": "Enviar WhatsApp", "type": "main", "index": 0 }]]
    },
    "Enviar WhatsApp": {
      "main": [[{ "node": "Marcar carrito como notificado", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" }
}
