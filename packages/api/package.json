{
  "name": "@acme/api",
  "version": "2.3.6-canary.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "exports": {
    "./_generated": {
      "types": "./.mercur/routes.d.ts"
    }
  },
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build && node ./scripts/bundle-dashboards.mjs",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "codegen": "mercurjs codegen",
    "cloud:prebuild": "mercurjs codegen"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.21.0",
    "@medusajs/admin-shared": "2.21.0",
    "@medusajs/cli": "2.21.0",
    "@medusajs/core-flows": "2.21.0",
    "@medusajs/dashboard": "2.21.0",
    "@medusajs/draft-order": "2.21.0",
    "@medusajs/framework": "2.21.0",
    "@medusajs/medusa": "2.21.0",
    "@mercurjs/cli": "2.3.6-canary.1",
    "@mercurjs/core": "2.3.6-canary.1",
    "@mercurjs/types": "2.3.6-canary.1",
    "http-proxy-middleware": "3.0.7",
    "pdf-lib": "1.17.1",
    "pg": "^8.11.3",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@acme/admin": "*",
    "@acme/vendor": "*",
    "@medusajs/test-utils": "2.21.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "yalc": "^1.0.0-pre.53",
    "@types/pg": "^8.6.1"
  },
  "engines": {
    "node": ">=20"
  }
}
