# Mismo bucket privado de B2 que ya usa la plataforma (ver packages/api/.env
# en el VPS para los valores de B2_KEY_ID y B2_APPLICATION_KEY -- son los
# mismos, una Application Key de B2 funciona para la API nativa y para la
# S3-compatible).
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_PRIVATE_BUCKET_NAME=hetnacnc-archivos-privados

# Endpoint S3-compatible de tu bucket -- se ve en B2 > Buckets > (tu bucket)
# > "Endpoint", algo como https://s3.us-west-002.backblazeb2.com
B2_S3_ENDPOINT=
