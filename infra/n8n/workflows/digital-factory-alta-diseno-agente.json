      "position": [896, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nconst raw = (item.archivo_base64 || '').split(',').pop();\nreturn [{ json: item, binary: { data: { data: raw, mimeType: 'application/octet-stream', fileName: item.archivo_filename } } }];"
      }
    },
