{
  "name": "WhatsApp - Respuestas de catálogo",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "whatsapp-in", "options": {} },
      "id": "webhook-in",
      "name": "WhatsApp entrante (Evolution API)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "// Evolution API manda el mensaje en body.data.\n// Ajusta estas rutas si tu version de Evolution usa otro formato.\nconst body = $input.first().json.body || $input.first().json;\nconst data = body.data || body;\n\nconst remoteJid = data?.key?.remoteJid || data?.from || '';\nconst phone = remoteJid.replace('@s.whatsapp.net', '').replace(/\\D/g, '');\n\nconst text =\n  data?.message?.conversation ||\n  data?.message?.extendedTextMessage?.text ||\n  data?.body ||\n  '';\n\nif (!phone || !text) {\n  return [];\n}\n\nconst palabrasHumano = ['humano', 'agente', 'asesor', 'representante', 'persona real', 'hablar con alguien'];\nconst textoLower = text.toLowerCase();\nlet quiereHumano = false;\nfor (let i = 0; i < palabrasHumano.length; i++) {\n  if (textoLower.indexOf(palabrasHumano[i]) !== -1) {\n    quiereHumano = true;\n  }\n}\n\nreturn [{ json: { phone, text: text.trim(), quiereHumano } }];"
      },
      "id": "parse-message",
      "name": "Extraer telefono y texto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 0]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": { "__rl": true, "mode": "name", "value": "whatsapp_catalogo_estado" },
        "matchType": "allConditions",
        "filters": { "conditions": [{ "keyName": "phone", "condition": "eq", "keyValue": "={{ $json.phone }}" }] },
        "returnAll": true
      },
      "alwaysOutputData": true,
      "id": "read-state",
      "name": "Leer estado de conversacion",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [448, 0]
    },
    {
      "parameters": {
        "jsCode": "const datos = $('Extraer telefono y texto').first().json;\nconst filas = $input.all();\nconst filaRaw = filas.length > 0 ? filas[0].json : null;\nconst fila = filaRaw && filaRaw.phone ? filaRaw : null;\n\nconst VENTANA_HANDOFF_HORAS = 24;\nlet handoffActivo = false;\nlet noMatchCountPrevio = 0;\n\nif (fila) {\n  noMatchCountPrevio = fila.no_match_count || 0;\n  if (fila.handoff) {\n    const actualizadoEn = new Date(fila.updated_at);\n    const horasDesde = (Date.now() - actualizadoEn.getTime()) / (1000 * 60 * 60);\n    if (horasDesde < VENTANA_HANDOFF_HORAS) {\n      handoffActivo = true;\n    }\n  }\n}\n\nif (handoffActivo) {\n  return [{ json: { accion: 'silenciar', phone: datos.phone } }];\n}\n\nif (datos.quiereHumano) {\n  return [{ json: { accion: 'traspaso', phone: datos.phone, text: datos.text, motivo: 'El cliente pidio hablar con una persona.' } }];\n}\n\nreturn [{ json: { accion: 'buscar', phone: datos.phone, text: datos.text, noMatchCountPrevio } }];"
      },
      "id": "decide-action",
      "name": "Decidir que hacer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [672, 0]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "outputKey": "silenciar", "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.accion }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "silenciar" }], "combinator": "and" } },
            { "outputKey": "traspaso", "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.accion }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "traspaso" }], "combinator": "and" } },
            { "outputKey": "buscar", "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [{ "leftValue": "={{ $json.accion }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "buscar" }], "combinator": "and" } }
          ]
        },
        "options": {}
      },
      "id": "route-action",
      "name": "Ruta segun accion",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [896, 0]
    },
    {
      "parameters": {},
      "id": "noop-silence",
      "name": "No hacer nada (humano atendiendo)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1120, -200]
    },
    {
      "parameters": {
        "jsCode": "const datos = $json;\nlet mensajeCliente;\nif (datos.motivo && datos.motivo.indexOf('No encontre') !== -1) {\n  mensajeCliente = 'No logre encontrar lo que buscas. Te voy a conectar con alguien del equipo para ayudarte mejor, en un momento te contactan por aqui.';\n} else {\n  mensajeCliente = 'Claro, ya te conecto con alguien del equipo. En un momento te contactan por aqui mismo.';\n}\n\nconst mensajeHumano = 'Traspaso de conversacion de WhatsApp\\nCliente: ' + datos.phone + '\\nUltimo mensaje: \"' + datos.text + '\"\\nMotivo: ' + datos.motivo + '\\n\\nAtiendelo por WhatsApp Web o el manager de Evolution.';\n\nconst ahoraIso = new Date().toISOString();\n\nreturn [{ json: { phone: datos.phone, text: datos.text, motivo: datos.motivo, mensajeCliente, mensajeHumano, ahoraIso } }];"
      },
      "id": "prepare-handoff",
      "name": "Preparar traspaso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 0]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "upsert",
        "dataTableId": { "__rl": true, "mode": "name", "value": "whatsapp_catalogo_estado" },
        "matchType": "allConditions",
        "filters": { "conditions": [{ "keyName": "phone", "condition": "eq", "keyValue": "={{ $json.phone }}" }] },
        "columns": {
          "mappingMode": "defineBelow",
          "value": { "phone": "={{ $json.phone }}", "handoff": true, "no_match_count": 0, "updated_at": "={{ $json.ahoraIso }}" },
          "schema": [
            { "id": "phone", "displayName": "phone", "type": "string", "canBeUsedToMatch": true },
            { "id": "handoff", "displayName": "handoff", "type": "boolean", "canBeUsedToMatch": true },
            { "id": "no_match_count", "displayName": "no_match_count", "type": "number", "canBeUsedToMatch": true },
            { "id": "updated_at", "displayName": "updated_at", "type": "string", "canBeUsedToMatch": true }
          ]
        }
      },
      "id": "save-handoff",
      "name": "Guardar traspaso activo",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [1344, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"number\": $(\"Preparar traspaso\").item.json.phone, \"text\": $(\"Preparar traspaso\").item.json.mensajeCliente } }}",
        "options": {}
      },
      "id": "reply-customer-handoff",
      "name": "Responder al cliente (traspaso)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1568, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"number\": ($env.HANDOFF_WHATSAPP_NUMBER || $env.OWNER_WHATSAPP_NUMBER), \"text\": $(\"Preparar traspaso\").item.json.mensajeHumano } }}",
        "options": {}
      },
      "id": "notify-human",
      "name": "Avisar a un humano",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1792, 0]
    },
    {
      "parameters": {
        "url": "={{ $env.MEDUSA_BACKEND_URL }}/store/products",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "q", "value": "={{ $json.text }}" },
            { "name": "region_id", "value": "={{ $env.MEDUSA_REGION_ID }}" },
            { "name": "limit", "value": "5" },
            { "name": "fields", "value": "id,title,handle,thumbnail,*variants.calculated_price" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "x-publishable-api-key", "value": "={{ $env.MEDUSA_PUBLISHABLE_KEY }}" }] },
        "options": {}
      },
      "id": "search-products",
      "name": "Buscar productos (Store API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "jsCode": "const datos = $('Decidir que hacer').first().json;\nconst products = $input.first().json.products || [];\nconst baseUrl = $env.STOREFRONT_URL || 'https://hetnacnc.com';\n\nconst sinResultados = products.length === 0;\nconst noMatchCountNuevo = sinResultados ? (datos.noMatchCountPrevio || 0) + 1 : 0;\n\nif (sinResultados && noMatchCountNuevo >= 2) {\n  return [{ json: { accion: 'traspaso', phone: datos.phone, text: datos.text, motivo: 'No encontre resultados en dos intentos seguidos.' } }];\n}\n\nlet reply;\nif (sinResultados) {\n  reply = 'No encontre productos para \"' + datos.text + '\". Puedes describirlo de otra forma (material, tamano, tipo de pieza)?';\n} else {\n  const lineas = [];\n  const maxProductos = products.length < 5 ? products.length : 5;\n  for (let i = 0; i < maxProductos; i++) {\n    const p = products[i];\n    const amount = p.variants && p.variants[0] && p.variants[0].calculated_price ? p.variants[0].calculated_price.calculated_amount : null;\n    const currency = p.variants && p.variants[0] && p.variants[0].calculated_price ? p.variants[0].calculated_price.currency_code.toUpperCase() : '';\n    const precio = amount != null ? ('$' + amount + ' ' + currency) : 'Consultar precio';\n    lineas.push('- ' + p.title + ' - ' + precio + '\\n  ' + baseUrl + '/mx/products/' + p.handle);\n  }\n  reply = 'Encontre esto para \"' + datos.text + '\":\\n\\n' + lineas.join('\\n\\n') + '\\n\\nQuieres que te ayude con alguno?';\n}\n\nreturn [{ json: { accion: 'responder', phone: datos.phone, reply, noMatchCountNuevo } }];"
      },
      "id": "format-reply",
      "name": "Formatear respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1344, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [{ "leftValue": "={{ $json.accion }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "traspaso" }],
          "combinator": "and"
        }
      },
      "id": "needs-handoff",
      "name": "Necesita traspaso?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1568, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/sendText/{{ $env.EVOLUTION_INSTANCE }}",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"number\": $json.phone, \"text\": $json.reply } }}",
        "options": {}
      },
      "id": "send-reply",
      "name": "Enviar respuesta por WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1792, 300]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "upsert",
        "dataTableId": { "__rl": true, "mode": "name", "value": "whatsapp_catalogo_estado" },
        "matchType": "allConditions",
        "filters": { "conditions": [{ "keyName": "phone", "condition": "eq", "keyValue": "={{ $(\"Formatear respuesta\").item.json.phone }}" }] },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "phone": "={{ $(\"Formatear respuesta\").item.json.phone }}",
            "handoff": false,
            "no_match_count": "={{ $(\"Formatear respuesta\").item.json.noMatchCountNuevo }}",
            "updated_at": "={{ $now.toISO() }}"
          },
          "schema": [
            { "id": "phone", "displayName": "phone", "type": "string", "canBeUsedToMatch": true },
            { "id": "handoff", "displayName": "handoff", "type": "boolean", "canBeUsedToMatch": true },
            { "id": "no_match_count", "displayName": "no_match_count", "type": "number", "canBeUsedToMatch": true },
            { "id": "updated_at", "displayName": "updated_at", "type": "string", "canBeUsedToMatch": true }
          ]
        }
      },
      "id": "save-normal-state",
      "name": "Guardar estado normal",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [2016, 300]
    }
  ],
