# --- Marketing automatizado (opcional) ---
# Sin RESEND_API_KEY, el email de bienvenida y el recordatorio de carrito
# abandonado simplemente no envían nada (no rompen el registro ni el checkout).
# Cuenta gratis en https://resend.com -> API Keys. El FROM debe ser un dominio
# verificado en Resend (o su sandbox onboarding@resend.dev para pruebas).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# URL pública del storefront, usada en el link "Terminar mi compra" del
# correo de carrito abandonado. Si no se define, usa STOREFRONT_REVALIDATE_URL.
STOREFRONT_URL=http://localhost:3000
# Ventana de tiempo para considerar un carrito "abandonado": no se le escribe
# antes de ABANDONED_CART_MIN_HOURS ni después de ABANDONED_CART_MAX_HOURS.
ABANDONED_CART_MIN_HOURS=3
ABANDONED_CART_MAX_HOURS=72

# URL del webhook de n8n que publica en redes sociales cuando subes un
# producto nuevo al catálogo. Sin esta variable, no se avisa a nadie (no
# rompe la creación del producto). Es la URL del nodo Webhook del workflow
# "Redes sociales - Producto nuevo" en https://n8n.hetnacnc.com.
N8N_PRODUCT_CREATED_WEBHOOK_URL=
