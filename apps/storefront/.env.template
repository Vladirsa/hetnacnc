# PLANTILLA DE EJEMPLO. Los valores reales van en apps/storefront/.env dentro del servidor.
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_REGION=mx
NEXT_PUBLIC_STRIPE_KEY=supersecret
REVALIDATE_SECRET=supersecret
NEXT_PUBLIC_SITE_NAME="HETNA CNC"
NEXT_PUBLIC_SITE_DESCRIPTION="Marketplace especializado en máquinas y accesorios CNC"
NEXT_PUBLIC_VENDOR_URL=http://localhost:7000

# --- Marketing automatizado (opcional) ---
# Sin estas variables, Analytics.tsx no inyecta ningún script (cero impacto en rendimiento).
# GA4: Google Analytics -> Admin -> Flujos de datos -> Web -> "G-XXXXXXX"
# Meta Pixel: Administrador de eventos -> tu pixel -> Configuración -> ID del pixel (solo el número)
# Se leen al compilar: después de cambiarlos hay que volver a hacer el build de la tienda.
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# Google Ads (opcional): remarketing dinámico con el catálogo y conversión de compra.
# Google Ads > Objetivos > Conversiones > tu conversión de compra > Configuración de la etiqueta:
# "AW-XXXXXXXXXX" es el ID y lo que va después de la "/" en send_to es la etiqueta.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# API de conversiones de Meta (opcional): la compra se reporta también desde el servidor
# (lib/analytics/meta-capi.ts), con el mismo id que el Pixel para que no se cuente doble.
# Administrador de eventos > tu conjunto de datos > Configuración > API de conversiones > Generar token.
# META_CAPI_TEST_CODE sólo para ver los eventos en "Probar eventos"; quítalo después.
META_CAPI_TOKEN=
META_CAPI_TEST_CODE=

# Verificación del dominio en el Business Manager de Meta (Configuración del negocio >
# Seguridad de la marca > Dominios > "Agregar etiqueta meta": sólo el valor de content).
META_DOMAIN_VERIFICATION=

# Catálogos /feeds/google.xml y /feeds/meta.xml (lib/feeds/catalogo.ts). Opcionales.
# FEED_INCLUIR_DIGITALES=1 mete diseños descargables y servicios (Google y Meta los rechazan).
# FEED_EXCLUIR_CATEGORIAS: expresión regular de categorías que no son producto físico.
FEED_INCLUIR_DIGITALES=
FEED_EXCLUIR_CATEGORIAS=
